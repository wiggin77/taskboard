{
  "listen": "127.0.0.1:8484",
  "poll_interval": "5m",
  "refresh_timeout": "5m",
  "project_keys": ["MM"],
  "merged_pr_days": 90,
  "done_days": 30,
  "attach_command": ["gnome-terminal", "--", "tmux", "attach", "-t", "{target}"],
  "repos_dir": "~/src",
  "worktree_dir": "~/worktrees",
  "worktree_links": ["~/src/enterprise"],
  "jira": {
    "base_url": "https://mattermost.atlassian.net",
    "jql": "(assignee = currentUser() OR \"matty code assigner[user picker (single user)]\" = currentUser()) AND statusCategory != Done ORDER BY updated DESC",
    "done_jql": "assignee = currentUser() OR \"matty code assigner[user picker (single user)]\" = currentUser()"
  },
  "repos": [
    {"name": "mattermost/mattermost", "path": "mattermost", "plans_dir": "plans"},
    {"name": "mattermost/mattermost-plugin-jira", "path": "~/src/mattermost-plugin-jira"}
  ],
  "github": {
    "organizations": ["mattermost", "mattermost-community"],
    "ignore_assigned_authors": ["mattermost-build"]
  }
}
