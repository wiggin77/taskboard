{
  "manifest_version": 3,
  "name": "taskboard tab groups",
  "version": "0.1.1",
  "description": "Opens taskboard's Jira, PR and terminal links in one tab group per ticket.",
  "permissions": ["tabs", "tabGroups", "storage", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "taskboard-tab-groups@wiggin77.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
