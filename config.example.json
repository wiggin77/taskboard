{
  "listen": "127.0.0.1:8484",
  "poll_interval": "120s",
  "idle_poll_interval": "0s",
  "refresh_timeout": "5m",
  "project_keys": ["MM"],
  "merged_pr_limit": 20,
  "done_days": 30,
  "ssh_host": "ubuntu",
  "attach_command": ["gnome-terminal", "--", "tmux", "attach", "-t", "{target}"],
  "allowed_hosts": [],
  "jira": {
    "base_url": "https://mattermost.atlassian.net",
    "jql": "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC"
  },
  "repos": [
    {"name": "mattermost/mattermost", "path": "/home/you/src/mattermost", "plans_dir": "plans"},
    {"name": "mattermost/mattermost-plugin-jira", "path": "/home/you/src/mattermost-plugin-jira"}
  ]
}
